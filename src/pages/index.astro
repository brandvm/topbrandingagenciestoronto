---
import Page from '../layouts/Page.astro';import Feature from '../components/Feature.astro';import GuideCard from '../components/GuideCard.astro';import Cover from '../components/Cover.astro';import Icon from '../components/Icon.astro';import AgencyIndex from '../components/AgencyIndex.astro';import Approach from '../components/Approach.astro';
import site from '../data/site.json';import {articles,href,withBase} from '../lib/content';
const posts=await articles();const featured=posts[0];
---
<Page>
<div class="publication-mast" aria-hidden="true">The Toronto Edit</div><section class="hero toronto-intro" data-review-anchor="hero"><div><p class="eyebrow">Toronto, through a branding lens</p><h1>A city of ideas.<br><em>A brand of your own.</em></h1></div><p class="intro">An editorial guide to Toronto’s branding talent. Explore the studios and specialists turning ambitious businesses into memorable brands.</p></section>{featured&&<article class="toronto-feature" data-review-anchor="featured-guide"><Cover eager slug={featured.data.slug}/><div class="feature-copy"><p class="eyebrow">The cover story / Branding</p><h2><a href={href(featured.data.slug)}>{featured.data.title}</a></h2><p>{featured.data.description}</p><a class="text-link" href={href(featured.data.slug)}>Read the story <Icon name="arrow-up-right"/></a></div></article>}<section class="section" data-review-anchor="guides"><div class="section-head"><div><p class="eyebrow">The reading list</p><h2>A different point of view.</h2></div><a class="text-link" href={withBase("/blog/")}>All guides <Icon name="arrow-up-right"/></a></div><div class="guide-grid">{posts.slice(1).map((post,index)=><GuideCard post={post} index={index}/>)}</div>{posts.length===0&&<p>No guides are published yet.</p>}</section><section class="section" data-review-anchor="agency-shortlist"><div class="index-head"><div><p class="eyebrow">Inside the guide</p><h2>Start your shortlist.</h2></div></div>{featured&&<AgencyIndex slug={featured.data.slug}/>}<p class="small" style="margin-top:20px">The first three agencies in the guide. Read the full comparison for rankings, qualifications, and methodology.</p></section><Approach/></Page>
